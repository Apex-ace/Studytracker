rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function ownsUserId(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUserId(userId) || isAdmin();

      // Self-registration is always a student. Promote the first admin manually
      // in the Firebase console after account creation.
      allow create: if ownsUserId(userId)
        && request.resource.data.role == "student"
        && request.resource.data.email == request.auth.token.email;

      // Students cannot change role/email/active state themselves.
      allow update: if isAdmin()
        || (ownsUserId(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /chapterProgress/{progressId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /skillProgress/{progressId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /mockTests/{testId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /studyActivities/{activityId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          (!("assignedByAdmin" in resource.data) || resource.data.assignedByAdmin != true)
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt", "linkedActualDate"])
        )
      );
      allow delete: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && (!("assignedByAdmin" in resource.data) || resource.data.assignedByAdmin != true)
        && (!("autoGenerated" in resource.data) || resource.data.autoGenerated != true)
      );
    }

    match /vocabulary/{wordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /appConfig/performance {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
